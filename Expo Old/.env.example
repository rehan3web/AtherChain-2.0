# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real values.

# ── Local Development ────────────────────────────────────────────────────────
#
# Running on a PC (web browser at localhost):
#   EXPO_PUBLIC_API_URL=http://localhost:3000
#
# Running on a phone via Expo Go (same WiFi as your PC):
#   Replace 192.168.x.x with YOUR laptop/PC's local IP address.
#   Find it with:  ipconfig  (Windows)  or  ifconfig / ip a  (Mac/Linux)
#   EXPO_PUBLIC_API_URL=http://192.168.100.130:3000
#
# Leave this line commented out when deploying to Replit — it auto-detects.
# EXPO_PUBLIC_API_URL=http://localhost:3000
