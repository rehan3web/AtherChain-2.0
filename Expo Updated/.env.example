# Copy this file to .env and set the public backend base URL.
# Web, Android and iOS all use this value. Never put private secrets here.
# Current development API; replace it for another backend/deployment.
EXPO_PUBLIC_API_URL=https://d416673a-8544-40c1-b01b-0b1828502824-00-2bo2qifkhyeu2.pike.replit.dev/api

# For a same-origin web proxy, /api is also supported (web only).
# For a phone, use a reachable HTTPS backend/proxy URL, not localhost.
# Replit/shell environment values override .env if the same key is set.
# Restart Expo after changing .env. Rebuild exported/native apps to update it.
