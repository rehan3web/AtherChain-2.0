{
  "expo": {
    "name": "Mobile App",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.atherchain.app",
      "associatedDomains": ["webcredentials:atherchain.com"]
    },
    "android": {
      "package": "com.atherchain.app",
      "intentFilters": [{
        "action": "VIEW",
        "autoVerify": true,
        "data": [{ "scheme": "https", "host": "atherchain.com" }],
        "category": ["BROWSABLE", "DEFAULT"]
      }]
    },
    "extra": {
      "eas": { "projectId": "8a5d8327-e345-4274-a180-f47a5d183369" }
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      ["expo-camera", {
        "cameraPermission": "Allow AtherChain to capture identity documents and face photos for verification.",
        "recordAudioAndroid": false,
        "microphonePermission": false
      }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
